# Pyth API key, sent as `Authorization: Bearer <key>`.
# Required by the upgraded Hermes endpoint from 2026-08-18 (Pyth Core upgrade).
# Get one at https://docs.pyth.network/price-feeds/pro/acquire-api-key
# When set, the plugin targets https://pyth.dourolabs.app/hermes automatically.
PYTH_API_KEY=

# Pyth Hermes API base URL. Overrides the automatic choice above.
# Legacy (no auth, until 2026-08-18): https://hermes.pyth.network
# Upgraded (requires PYTH_API_KEY):   https://pyth.dourolabs.app/hermes
# PYTH_BASE_URL=https://pyth.dourolabs.app/hermes

# Request timeout in milliseconds (default: 10000)
PYTH_TIMEOUT_MS=10000

# Number of retries on transient errors (default: 2)
PYTH_RETRIES=2
